# LinuxServer dwara pradan kiye gaye Chromium image ka upyog karein
FROM lscr.io/linuxserver/chromium:latest

# Render ke default PORT (10000) ko noVNC ke default port (3000) par map karein
# LinuxServer image andar se 3000 port par sunta hai, isliye environment variable se override karna zaroori hai
ENV CUSTOM_PORT=3000
