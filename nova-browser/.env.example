# ══════════════════════════════════════════════════
# Nova Browser · Environment Configuration
# Copy this file to .env and fill in real values
#   cp .env.example .env
# ══════════════════════════════════════════════════

# ── Security ──────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
CHROMIUM_PASSWORD=StrongPassword123!

# ── Admin credentials ─────────────────────────────
# Generate hash first: node scripts/generate-hash.js YourPassword
ADMIN_USER=admin
ADMIN_PASS_HASH=$2b$12$REPLACE_WITH_REAL_BCRYPT_HASH

# ── Server ────────────────────────────────────────
NODE_ENV=production
PORT=8080
MAX_TABS=20
SESSION_TTL_HOURS=12

# ── Container URLs ────────────────────────────────
CHROMIUM_URL=ws://nova-chromium:9222
PROFILES_PATH=/data/profiles
DOWNLOADS_PATH=/data/downloads

# ── Modes ─────────────────────────────────────────
EPHEMERAL=false

# ── Network / Proxy (optional) ────────────────────
OUTBOUND_PROXY=
TURN_SERVER_URL=
TURN_SERVER_USER=
TURN_SERVER_PASS=
